      "direction": "均質・実用→大胆・表現的",
      "scale": {
        "1": "本文中心・サイズ差が小さい",
        "2": "実用的な小見出しで整理",
        "3": "明瞭な見出し階層",
        "4": "大見出し・太さやサイズの強い差",
        "5": "巨大文字・独自組版・文字自体が主役"
      }
    },
    {
      "id": "contrast",
      "short": "C",
      "name_ja": "視覚的な明暗差",
      "direction": "穏やか→強烈",
      "scale": {
        "1": "面・罫線の差がごく小さい",
        "2": "淡い面と控えめな境界",
        "3": "本文と背景・領域の差が明瞭",
        "4": "強い明暗差やアクセント",
        "5": "白黒反転・強い明暗ブロックが主役"
      }
    },
    {
      "id": "motion",
      "short": "M",
      "name_ja": "動きの存在感",
      "direction": "静止→没入的",
      "scale": {
        "1": "静止主体",
        "2": "hover・focus等の短い状態変化",
        "3": "開閉・出現等の局所的な遷移",
        "4": "スクロール連動・連続した演出",
        "5": "全面映像・3D・持続的なインタラクション"
      }
    },
    {
      "id": "tone",
      "short": "O",
      "name_ja": "印象の親しみやすさ",
      "direction": "公的・厳格→遊び心",
      "scale": {
        "1": "公的・厳格・装飾を抑制",
        "2": "堅実・業務的",
        "3": "中立・現代的",
        "4": "親しみ・柔らかさ",
        "5": "遊び心・個性・感情表現が強い"
      }
    }
  ],
  "sections": [
    {
      "id": "hero",
      "definition_ja": "ページ冒頭で企業の価値・主題と主要導線を示す領域。"
    },
    {
      "id": "nav",
      "definition_ja": "ページや主要領域を移動するためのメニュー。"
    },
    {
      "id": "CTA band",
      "definition_ja": "問い合わせ・資料請求等の行動を促す、横断的な帯状領域。"
    },
    {
      "id": "cards",
      "definition_ja": "画像・見出し・説明等をひとまとまりにした反復単位。"
    },
    {
      "id": "case list",
      "definition_ja": "制作実績・導入事例を、案件名や概要とともに並べる一覧。"
    },
    {
      "id": "news list",
      "definition_ja": "日付・カテゴリ・題名を基本にした更新情報の一覧。"
    },
    {
      "id": "stats",
      "definition_ja": "実績数・年数等の数値と単位・説明を組み合わせる領域。"
    },
    {
      "id": "logo wall",
      "definition_ja": "取引先・導入企業等のロゴを反復配置する領域。"
    },
    {
      "id": "footer",
      "definition_ja": "末尾に補助導線・会社情報・法的情報をまとめる領域。"
    },
    {
      "id": "forms",
      "definition_ja": "入力・選択・検証・送信を伴う情報収集の領域。"
    },
    {
      "id": "buttons",
      "definition_ja": "送信・開閉等の操作要素。遷移を行うボタン風リンクも視覚分類として含む。"
    }
  ],
