      "scale": {
        "1": "小さい余白・ほぼ直角",
        "2": "控えめな余白・小角丸",
        "3": "標準余白・中角丸",
        "4": "大きな余白・大角丸",
        "5": "非常に広い余白・ピル形主体"
      }
    },
    {
      "id": "typography",
